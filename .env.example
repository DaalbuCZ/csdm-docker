# Database (used by both the db service and the app service)
POSTGRES_DB=csdm
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_PORT=5432

# Web UI
PORT=3000
# Shared secret for friends (Authorization: Bearer <token>). Leave empty for open LAN access.
API_TOKEN=
# Public URL of this server, used for Steam login callbacks, e.g. https://csdm.example.com
PUBLIC_URL=
# Long random string used to sign login sessions. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-secret
STEAM_API_KEY=
# How often tracked users are checked for new matches (minutes, 0 disables)
TRACK_POLL_MINUTES=15

# Post-match summaries in Discord after each analyzed demo (optional)
DISCORD_WEBHOOK_URL=

# On-demand highlight clips: seconds of context before the first kill / after the last kill,
# and max total clip length.
CLIP_PADDING_SECONDS=6
CLIP_MAX_SECONDS=90
